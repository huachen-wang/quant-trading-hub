# App
NODE_ENV=development
PORT=3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=mysql://quant:quantpass@127.0.0.1:3306/quant_trading_hub
DATABASE_HOST=localhost
DATABASE_USER=quant
DATABASE_PASSWORD=quantpass
DATABASE_NAME=quant_trading_hub

# Auth
JWT_SECRET=change-me
COOKIE_SECRET=change-me
# 独立于 JWT/COOKIE 的随机密钥；生产环境至少 32 bytes。
DOWNLOAD_SIGNING_SECRET=
ADMIN_EMAIL=admin@eaxau.com
ADMIN_PASSWORD=change-me
# MVP 使用一个稳定管理员身份；安全边界是每个敏感步骤使用不可重放的 RFC 6238 TOTP。
# TOTP 解码后至少 20 bytes。未配置时所有 USDT 收款/入金指令 fail closed。
# 生成：python3 -c "import base64,secrets; print(base64.b32encode(secrets.token_bytes(20)).decode().rstrip('='))"
# 将该 secret 以“AI量化联盟 Admin”手动录入 1Password/Google Authenticator/Authy；不得发到聊天或写入数据库。
ADMIN_TOTP_SECRET_BASE32=
# 默认 0：限流只使用 TCP socket 对端，忽略可伪造的 X-Forwarded-For。
# 仅在 Railway/边缘代理链路已确认后设为精确的受信跳数；代码从右向左解析，不相信首段。
ADMIN_TRUSTED_PROXY_HOPS=0

# OAuth / Manus runtime
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
OWNER_NAME=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=

# Email
RESEND_API_KEY=
EMAIL_FROM=EAXAU <noreply@eaxau.com>
EMAIL_REPLY_TO=
# Comma-separated Resend-verified sender domains. The sender is rejected unless
# its exact domain is listed here.
EMAIL_VERIFIED_DOMAINS=eaxau.com
# Stable random secret (at least 32 chars) for token signing, privacy-preserving
# rate-limit hashes and encrypted confirmation outbox payloads. Keep unchanged.
EMAIL_SUBSCRIPTION_SECRET=
EMAIL_PUBLIC_BASE_URL=https://www.eaxau.com
# Exact trusted proxy depth for newsletter anti-abuse IP keys. Keep 0 until the
# Railway proxy chain is verified; never trust the left-most forwarded value.
EMAIL_TRUSTED_PROXY_HOPS=0
# Resend webhook signing secret for /api/email/resend-webhook.
RESEND_WEBHOOK_SECRET=

# XAU CRM is the operating source for customer identity, email permission and
# suppressions. EAXAU posts brand-tagged evidence through a durable local outbox.
XAU_CRM_BASE_URL=https://xau-crm.vercel.app
CRM_INGEST_SECRET=
CRM_EMAIL_EVENTS_SECRET=

# Feature flags
ENABLE_PHONE_VERIFICATION=false
ENABLE_USDT_PAYMENT=true
ENABLE_ZPAY=true
EAXAU_V2_ENABLED=true

# Credentialed API origins，逗号分隔；官网两个域名已内置。
CORS_ALLOWED_ORIGINS=

# EAXAU V2 data provider
# DEMO: deterministic sample data. HTTP: brand-neutral Quant Data Core.
# NIUBANG: read-only adapter for the existing public signal.detail procedure.
# When empty, NIUBANG is selected if NIUBANG_DATA_URL exists, then HTTP if
# QUANT_DATA_CORE_URL exists; otherwise the app stays in clearly labelled DEMO.
V2_DATA_PROVIDER=
QUANT_DATA_CORE_URL=
QUANT_DATA_CORE_API_KEY=
QUANT_DATA_CORE_TIMEOUT_MS=8000
NIUBANG_DATA_URL=
NIUBANG_DATA_API_KEY=
# JSON object: EAXAU core strategy id -> Niubang public signal slug.
# Example: {"jingge-v51":"jingge-tiema","night-hunter":"night-hunter"}
NIUBANG_STRATEGY_MAP={}

# Payment
# 下方地址仅用于 EA 商城商户收款，绝不用于客户券商入金或平台代收。
USDT_TRC20_ADDRESS=
USDT_ERC20_ADDRESS=
# 同时配置两条链时必须显式指定唯一报价网络：TRC20 | ERC20。
USDT_DEFAULT_NETWORK=
USDT_TRC20_QR_URL=
USDT_ERC20_QR_URL=
# 手动结算报价：1 USDT 兑换的 CNY 数。与收款地址一起配置后 USDT 方式才会开启。
USDT_CNY_PER_USDT=
# 当前只开放 MANUAL：管理员在外部区块浏览器/托管商核验后录入。
# RPC 提供器接口已预留，未完成密钥、确认数和异常处理审核前不得切换。
USDT_VERIFICATION_PROVIDER=MANUAL
USDT_TRON_RPC_URL=
USDT_EVM_RPC_URL=
# AI 量化联盟企业代收地址由管理后台地址池显式登记，一地址一笔 intent 永久占用。
# 服务器不配置、不保存、不使用私钥。当前默认 MANUAL；BVNK/Cobo 适配器未实现前会 fail closed。
FUNDING_CUSTODY_PROVIDER=MANUAL
# 预留成熟企业钱包适配：BVNK | COBO。适配器未实现前选中任何一项都会启动失败，不会伪装自动转币。
BVNK_API_BASE_URL=
BVNK_HAWK_ID=
BVNK_HAWK_SECRET=
BVNK_WALLET_ID=
BVNK_WEBHOOK_SECRET=
COBO_API_BASE_URL=
COBO_API_PUBLIC_KEY=
COBO_WALLET_ID=
COBO_WEBHOOK_SECRET=
# 业务服务器不接收 Cobo/BVNK 转出签名私钥；转币在其企业控制台/独立审批设备完成。
ZPAY_PID=
ZPAY_KEY=
ZPAY_GATEWAY=https://zpayz.cn
ZPAY_NOTIFY_URL=
ZPAY_RETURN_URL=

# SMS
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# Built-in services
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Local debugging
EXPO_PUBLIC_DEBUG_AUTH=false
EXPO_PUBLIC_DEBUG_API=false
